{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "planner-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "tailwind-watch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tailwindcss", "-i", "./input.css", "-o", "./public/output.css", "--watch"],
      "port": 5999
    }
  ]
}
